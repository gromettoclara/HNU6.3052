<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:tei="http://www.tei-c.org/ns/1.0"
    xmlns="http://www.w3.org/1999/xhtml"
    exclude-result-prefixes="xs tei"
    version="3.0">
    
    <xsl:import href="/usr/share/xml/tei/stylesheet/html/html.xsl"/>

    <xsl:param name="numberHeadings" select="'false'"/>
    <xsl:param name="autoEndNotes" select="'true'"/>
    <xsl:param name="footnoteBackLink" select="'true'"/>

    <xsl:param name="documentationLanguage" select="'fr'"/>
    <xsl:param name="lang" select="'fr'"/>
    <xsl:param name="doclang" select="'fr'"/>

    <xsl:param name="cssFile" select="resolve-uri('hugo.css', static-base-uri())"/>

    <xsl:template match="tei:pb">
        <xsl:variable name="value" select="concat('[', @n, ']')"/>
        <xsl:choose>
            <xsl:when test="ancestor::tei:p">
                <span class="pagebreak"><xsl:value-of select="$value"/></span>
            </xsl:when>
            <xsl:otherwise>
                <div class="pagebreak"><xsl:value-of select="$value"/></div>
            </xsl:otherwise>
        </xsl:choose>
    </xsl:template>

    <xsl:template name="stdfooter">
        <div class="stdfooter autogenerated">
            <p>Projet réalisé par des étudiants très motivés et sympatiques.</p>
        </div>
    </xsl:template>

    <xsl:param name="pageLayout">Complex</xsl:param>
    <xsl:param name="navbarFile" select="resolve-uri('navbar.xml', static-base-uri())"/>

    <xsl:template name="mainPage">
        <xsl:param name="currentID"/>
        <!-- header -->
        <header>
            <xsl:call-template name="hdr"/>
            <xsl:call-template name="hdr2"/>
        </header>
        <main>
            <xsl:apply-templates select="descendant-or-self::tei:TEI/tei:text"/>
            <xsl:call-template name="stdfooter"/>
        </main>
        <script src="./hugo.js">/**/</script>
    </xsl:template>
</xsl:stylesheet>
