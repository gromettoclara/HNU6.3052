%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Titres des documents
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\RequirePackage{titlesec}

% ============================
% Plan de cours
% ============================
\makeatletter
\newcommand{\courstitle}[1]{%
    \def\@courstitle{#1}%
}

\newcommand{\courssubtitle}[1]{%
    \def\@courssubtitle{#1}%
}

\newcommand{\makecourstitle}{%
    \begin{center}
        \printinstitutionlogo\par
        \vspace{1em}
        {\Huge\bfseries\color{Accent}\@courstitle\par}
        \vspace{0.5em}
        {\Large\itshape\color{SubtitleGray}\@courssubtitle\par}
        \vspace{1em}
        \hrule
    \end{center}
    \vspace{0.5em}
}
\makeatother

% ============================
% Notes de cours
% ============================
\makeatletter
\newcommand{\notestitle}[1]{%
    \def\@notestitle{#1}%
}

\newcommand{\notessubtitle}[1]{%
    \def\@notessubtitle{#1}%
}

\newcommand{\makenotestitle}{%
    \begin{center}
        {\LARGE\bfseries\color{Accent}\@notestitle\par}
        \vspace{0.4em}
        {\large\color{SubtitleGray}\@notessubtitle\par}
        \vspace{1em}
        \hrule
    \end{center}
    \vspace{1.5em}
}
\makeatother

% ============================
% sections etc
% ============================

\titleformat{\section}%commmand
{\Large\bfseries\color{Accent}}%format
{}%label
{1em}%sep
{}%beforecode []%aftercode

\titlespacing*{\section}
  {0pt}    % indentation à gauche
  {1.5ex}  % espace avant
  {0.5ex}  % espace après

\titleformat{\subsection}
{\large\bfseries\color{Accent}}
{\thesubsection}
{1em}
{}

\titleformat{\subsubsection}
{\large\bfseries\color{Accent}}
{\thesubsubsection}
{0.7em}
{}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Logo institutionnel
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\makeatletter
\newcommand{\institutionlogo}[1]{%
    \def\@institutionlogo{#1}%
}

\newcommand{\printinstitutionlogo}{%
    \ifdefined\@institutionlogo
        \includegraphics[width=4cm]{\@institutionlogo}
    \fi
}
\makeatother

