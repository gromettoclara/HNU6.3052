\newtcolorbox{important}{
    enhanced,
    breakable,
    colback=LightAccent,
    colframe=Accent,
    boxrule=0.5pt,
    arc=2.5mm,
    left=10pt,
    right=8pt,
    top=8pt,
    bottom=8pt,
    before skip=18pt,
    after skip=10pt,
    overlay={
    \node[
        circle,
        fill=Accent,
        text=white,
        minimum size=7mm,
        inner sep=0pt
    ] at ([xshift=-1pt]frame.north west) {\faExclamation};
}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Renvois
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\grammaire}[1]{%
    \marginnote{%
        \raggedright
        \footnotesize
        \color{Accent}%
        \textsc{gram.}\\[-0.2ex]
        \color{SubtitleGray}#1%
    }%
}

\newcommand{\site}[1]{%
    \marginnote{%
        \raggedright
        \footnotesize
        \color{Accent}%
        %\textsc{Lat. elec.}\\[-0.2ex]
        \color{SubtitleGray}\href{#1}{vers le site}%
    }%
}

\newcommand{\exercice}[1]{%
    \marginnote{%
        \raggedright
        \footnotesize
        \color{Accent}%
        \textsc{ex.}\\[-0.2ex]
        \color{SubtitleGray}#1%
    }%
}

\newcommand{\lat}[1]{%
  \textsl{\foreignlanguage{latin}{#1}}%
}

\newcommand{\fr}[1]{%
  \textit{\foreignlanguage{french}{\enquote{#1}}}%
}

\newcommand{\exemple}[1]{%
  \textcolor{Example}{\textit{#1}}%
}

\newcommand{\definition}[1]{%
  \textcolor{Definition}{#1}%
}

\newcommand{\contexte}[1]{%
  \textcolor{black!60}{\small #1}%
}

