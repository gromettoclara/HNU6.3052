\newcounter{exocours}[section]
\renewcommand{\theexocours}{\thesection.\arabic{exocours}}

\newtcolorbox{exocours}[1][]{
    breakable,
    enhanced,
    colback=white,
    colframe=Exo,
    boxrule=0pt,
    leftrule=1pt,
    arc=0pt,
    left=8pt,
    right=0pt,
    top=0pt,
    bottom=0pt,
    before skip=1em,
    after skip=1em,
    before upper={
        \refstepcounter{exocours}%
        \noindent
        {\bfseries\color{Exo}%
        Exercice~\theexocours
        \ifstrempty{#1}{}{~---~#1}}%
        \par\nobreak
        \color{black!80}%
    }
}


